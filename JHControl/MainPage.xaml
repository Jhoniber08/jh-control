<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JHControl.MainPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Bg}">

    <Grid>
        <ScrollView x:Name="Scroller">
            <VerticalStackLayout Padding="{OnPlatform iOS='16,54,16,28', Default='16,14,16,28'}"
                                 Spacing="14" MaximumWidthRequest="460">

                <!-- Encabezado -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label VerticalOptions="Center" FontSize="18" FontAttributes="Bold">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="JH " />
                                <Span Text="Control" TextColor="{StaticResource Acc}" />
                                <Span Text=" Universal" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Button Grid.Column="1" Text="Mis TVs" ImageSource="tv.png" ContentLayout="Left,6"
                            Clicked="OnOpenDevices" HeightRequest="40" CornerRadius="20" FontSize="13" Padding="14,0" />
                </Grid>

                <!-- Power · TV actual · Fuente -->
                <Grid ColumnDefinitions="62,*,62" ColumnSpacing="10">
                    <Button ImageSource="power.png" BackgroundColor="{StaticResource Red}" BorderColor="#FF7B88"
                            WidthRequest="62" HeightRequest="62" CornerRadius="31"
                            CommandParameter="power" Pressed="OnKeyPressed" Released="OnKeyReleased" />

                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12,8">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOpenDevices" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                            <Image Grid.RowSpan="2" Source="tv.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" />
                            <Label x:Name="TvName" Grid.Column="1" Text="Buscar televisor" FontSize="15"
                                   FontAttributes="Bold" LineBreakMode="TailTruncation" MaxLines="1" />
                            <Grid Grid.Column="1" Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                <Ellipse x:Name="Dot" WidthRequest="8" HeightRequest="8" Fill="#8B93A8" VerticalOptions="Center" />
                                <Label x:Name="StatusLbl" Grid.Column="1" Text="Toca aquí para encontrar tu TV" FontSize="12"
                                       TextColor="{StaticResource Mut}" LineBreakMode="TailTruncation" MaxLines="1" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Button Grid.Column="2" ImageSource="input.png" WidthRequest="62" HeightRequest="62" CornerRadius="31"
                            CommandParameter="input" Pressed="OnKeyPressed" Released="OnKeyReleased" />
                </Grid>

                <!-- Selector: Botones / Deslizar -->
                <Border BackgroundColor="{StaticResource Panel}" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 14"
                        Padding="4" HorizontalOptions="Center" WidthRequest="260">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                        <Button x:Name="ModeBtns" Text="Botones" HeightRequest="36" CornerRadius="10" FontSize="13"
                                BackgroundColor="{StaticResource Acc}" BorderWidth="0" Clicked="OnModeButtons" />
                        <Button x:Name="ModePad" Grid.Column="1" Text="Deslizar" HeightRequest="36" CornerRadius="10" FontSize="13"
                                BackgroundColor="Transparent" BorderWidth="0" Clicked="OnModePad" />
                    </Grid>
                </Border>

                <!-- Panel táctil: desliza = flechas, toque = OK -->
                <Border x:Name="PadPanel" IsVisible="False" HeightRequest="260" Margin="0,6,0,0"
                        BackgroundColor="#1A1E2B" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 28">
                    <Border.GestureRecognizers>
                        <SwipeGestureRecognizer Direction="Up" Swiped="OnSwiped" Threshold="40" />
                        <SwipeGestureRecognizer Direction="Down" Swiped="OnSwiped" Threshold="40" />
                        <SwipeGestureRecognizer Direction="Left" Swiped="OnSwiped" Threshold="40" />
                        <SwipeGestureRecognizer Direction="Right" Swiped="OnSwiped" Threshold="40" />
                        <TapGestureRecognizer Tapped="OnPadTapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="6" InputTransparent="True">
                        <Label Text="☝" FontSize="34" HorizontalOptions="Center" TextColor="{StaticResource Mut}" />
                        <Label Text="Desliza para moverte" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Text="Toca una vez para OK" FontSize="13" TextColor="{StaticResource Mut}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Cruceta -->
                <Border x:Name="DpadPanel" WidthRequest="260" HeightRequest="260" HorizontalOptions="Center" Margin="0,6,0,0"
                        BackgroundColor="#1A1E2B" Stroke="{StaticResource Line}" StrokeThickness="1" StrokeShape="Ellipse">
                    <Grid RowDefinitions="*,1.15*,*" ColumnDefinitions="*,1.15*,*">
                        <Button Grid.Column="1" ImageSource="up.png" BackgroundColor="Transparent" BorderWidth="0"
                                HeightRequest="-1" VerticalOptions="Fill" ClassId="rep"
                                CommandParameter="up" Pressed="OnKeyPressed" Released="OnKeyReleased" />
                        <Button Grid.Row="1" ImageSource="left.png" BackgroundColor="Transparent" BorderWidth="0"
                                HeightRequest="-1" VerticalOptions="Fill" ClassId="rep"
                                CommandParameter="left" Pressed="OnKeyPressed" Released="OnKeyReleased" />
                        <Button Grid.Row="1" Grid.Column="1" Text="OK" FontSize="18" Margin="6"
                                BackgroundColor="#343C57" BorderColor="#3D4766" CornerRadius="44"
                                HeightRequest="-1" VerticalOptions="Fill"
                                CommandParameter="ok" Pressed="OnKeyPressed" Released="OnKeyReleased" />
                        <Button Grid.Row="1" Grid.Column="2" ImageSource="right.png" BackgroundColor="Transparent" BorderWidth="0"
                                HeightRequest="-1" VerticalOptions="Fill" ClassId="rep"
                                CommandParameter="right" Pressed="OnKeyPressed" Released="OnKeyReleased" />
                        <Button Grid.Row="2" Grid.Column="1" ImageSource="down.png" BackgroundColor="Transparent" BorderWidth="0"
                                HeightRequest="-1" VerticalOptions="Fill" ClassId="rep"
                                CommandParameter="down" Pressed="OnKeyPressed" Released="OnKeyReleased" />
                    </Grid>
                </Border>

                <!-- Atrás · Inicio · Menú -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <Button Text="Atrás" ImageSource="back.png" ContentLayout="Left,6"
                            CommandParameter="back" Pressed="OnKeyPressed" Released="OnKeyReleased" />
                    <Button Grid.Column="1" Text="Inicio" ImageSource="home.png" ContentLayout="Left,6"
                            CommandParameter="home" Pressed="OnKeyPressed" Released="OnKeyReleased" />
                    <Button Grid.Column="2" Text="Menú" ImageSource="menu.png" ContentLayout="Left,6"
                            CommandParameter="menu" Pressed="OnKeyPressed" Released="OnKeyReleased" />
                </Grid>

                <!-- Volumen · centro · Canal -->
                <Grid ColumnDefinitions="72,*,72" ColumnSpacing="12">
                    <Border BackgroundColor="{StaticResource Key}" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 36">
                        <VerticalStackLayout>
                            <Button Text="+" FontSize="28" BackgroundColor="Transparent" BorderWidth="0" HeightRequest="68"
                                    ClassId="rep" CommandParameter="volup" Pressed="OnKeyPressed" Released="OnKeyReleased" />
                            <Label Text="VOL" FontSize="11" TextColor="{StaticResource Mut}" HorizontalOptions="Center" />
                            <Button Text="−" FontSize="28" BackgroundColor="Transparent" BorderWidth="0" HeightRequest="68"
                                    ClassId="rep" CommandParameter="voldown" Pressed="OnKeyPressed" Released="OnKeyReleased" />
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                        <Button Text="Silencio" ImageSource="mute.png" ContentLayout="Left,6" HeightRequest="46"
                                CommandParameter="mute" Pressed="OnKeyPressed" Released="OnKeyReleased" />
                        <Button Text="123  Números" HeightRequest="46" Clicked="OnToggleNum" />
                        <Button Text="Escribir" ImageSource="keyboard.png" ContentLayout="Left,6" HeightRequest="46" Clicked="OnToggleTxt" />
                    </VerticalStackLayout>

                    <Border Grid.Column="2" BackgroundColor="{StaticResource Key}" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 36">
                        <VerticalStackLayout>
                            <Button ImageSource="up.png" BackgroundColor="Transparent" BorderWidth="0" HeightRequest="68"
                                    ClassId="rep" CommandParameter="chup" Pressed="OnKeyPressed" Released="OnKeyReleased" />
                            <Label Text="CH" FontSize="11" TextColor="{StaticResource Mut}" HorizontalOptions="Center" />
                            <Button ImageSource="down.png" BackgroundColor="Transparent" BorderWidth="0" HeightRequest="68"
                                    ClassId="rep" CommandParameter="chdown" Pressed="OnKeyPressed" Released="OnKeyReleased" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Panel numérico -->
                <Border x:Name="NumPanel" IsVisible="False" Style="{StaticResource Card}" Padding="12">
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                        <Button Text="1" FontSize="18" CommandParameter="n1" Pressed="OnKeyPressed" Released="OnKeyReleased" />
                        <Button Grid.Column="1" Text="2" FontSize="18" CommandParameter="n2" Pressed="OnKeyPressed" Released="OnKeyReleased" />
                        <Button Grid.Column="2" Text="3" FontSize="18" CommandParameter="n3" Pressed="OnKeyPressed" Released="OnKeyReleased" />
                        <Button Grid.Row="1" Text="4" FontSize="18" CommandParameter="n4" Pressed="OnKeyPressed" Released="OnKeyReleased" />
                        <Button Grid.Row="1" Grid.Column="1" Text="5" FontSize="18" CommandParameter="n5" Pressed="OnKeyPressed" Released="OnKeyReleased" />
                        <Button Grid.Row="1" Grid.Column="2" Text="6" FontSize="18" CommandParameter="n6" Pressed="OnKeyPressed" Released="OnKeyReleased" />
                        <Button Grid.Row="2" Text="7" FontSize="18" CommandParameter="n7" Pressed="OnKeyPressed" Released="OnKeyReleased" />
                        <Button Grid.Row="2" Grid.Column="1" Text="8" FontSize="18" CommandParameter="n8" Pressed="OnKeyPressed" Released="OnKeyReleased" />
                        <Button Grid.Row="2" Grid.Column="2" Text="9" FontSize="18" CommandParameter="n9" Pressed="OnKeyPressed" Released="OnKeyReleased" />
                        <Button Grid.Row="3" Text="Info" CommandParameter="info" Pressed="OnKeyPressed" Released="OnKeyReleased" />
                        <Button Grid.Row="3" Grid.Column="1" Text="0" FontSize="18" CommandParameter="n0" Pressed="OnKeyPressed" Released="OnKeyReleased" />
                        <Button Grid.Row="3" Grid.Column="2" Text="Salir" CommandParameter="exit" Pressed="OnKeyPressed" Released="OnKeyReleased" />
                    </Grid>
                </Border>

                <!-- Panel de texto -->
                <Border x:Name="TxtPanel" IsVisible="False" Style="{StaticResource Card}" Padding="12">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry x:Name="TxtEntry" Placeholder="Escribe para buscar en la TV…" ReturnType="Send" Completed="OnSendText" />
                            <Button Grid.Column="1" Text="Enviar" BackgroundColor="{StaticResource Acc}" BorderWidth="0"
                                    HeightRequest="46" Padding="16,0" Clicked="OnSendText" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <Button Text="Buscar" HeightRequest="46" CommandParameter="search" Pressed="OnKeyPressed" Released="OnKeyReleased" />
                            <Button Grid.Column="1" Text="⌫ Borrar" HeightRequest="46" CommandParameter="backspace" Pressed="OnKeyPressed" Released="OnKeyReleased" />
                            <Button Grid.Column="2" Text="↺ Repetir" HeightRequest="46" CommandParameter="replay" Pressed="OnKeyPressed" Released="OnKeyReleased" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Reproducción -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <Button ImageSource="rew.png" ClassId="rep" CommandParameter="rew" Pressed="OnKeyPressed" Released="OnKeyReleased" />
                    <Button Grid.Column="1" ImageSource="playpause.png" CommandParameter="play" Pressed="OnKeyPressed" Released="OnKeyReleased" />
                    <Button Grid.Column="2" ImageSource="ff.png" ClassId="rep" CommandParameter="ff" Pressed="OnKeyPressed" Released="OnKeyReleased" />
                </Grid>

                <!-- Apps -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Button Text="NETFLIX" BackgroundColor="#141414" TextColor="#E50914" BorderColor="#333333" HeightRequest="48"
                            CommandParameter="netflix" Pressed="OnKeyPressed" Released="OnKeyReleased" />
                    <Button Grid.Column="1" Text="▶ YouTube" BackgroundColor="#FF0033" TextColor="White" BorderWidth="0" HeightRequest="48"
                            CommandParameter="youtube" Pressed="OnKeyPressed" Released="OnKeyReleased" />
                    <Button Grid.Column="2" Text="prime video" BackgroundColor="#00A8E1" TextColor="White" BorderWidth="0" HeightRequest="48"
                            CommandParameter="prime" Pressed="OnKeyPressed" Released="OnKeyReleased" />
                </Grid>

                <Label Text="JH Control Universal · por Jhoniber De la Cruz" FontSize="11"
                       TextColor="{StaticResource Mut}" HorizontalOptions="Center" Margin="0,10,0,0" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Aviso flotante -->
        <Border x:Name="Toast" IsVisible="False" Opacity="0" InputTransparent="True"
                VerticalOptions="End" HorizontalOptions="Center" Margin="20,0,20,36"
                BackgroundColor="#222838" Stroke="{StaticResource Line}" StrokeShape="RoundRectangle 12" Padding="16,10">
            <Label x:Name="ToastLbl" FontSize="13" HorizontalTextAlignment="Center" />
        </Border>
    </Grid>
</ContentPage>
